# "Fale conosco" — enviado via Resend (https://resend.com)
# Chave criada em resend.com → API Keys (começa por re_)
NUXT_MAIL_PASS=

# Email da CDA Girls que recebe as mensagens.
# Sem domínio próprio verificado no Resend, tem de ser o mesmo email
# com que a conta Resend foi criada.
NUXT_MAIL_USER=cdagirls.ti@gmail.com

# Destino alternativo (opcional, padrão: NUXT_MAIL_USER)
# NUXT_CONTACT_TO=

# Remetente (opcional; só mudar depois de verificar um domínio no Resend)
# NUXT_MAIL_FROM="Site CDA Girls <contacto@seudominio.com>"

# Link privado do grupo da comunidade (botões "Juntar-se") — não versionar
NUXT_JOIN_URL=
